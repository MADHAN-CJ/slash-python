ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# PYTHON_BIN=python3
# RUN_TIMEOUT_MS=10000
# PORT=5180

# Optional: let scripts `import slashdhan` (read-only Dhan market data from the /markets Dhan MCP).
# URL alone: scripts are sent to that MCP's HTTP API (POST /api/v1/run) and run in ITS sandbox (stdlib only,
# no numpy/pandas, PYTHON_BIN unused). URL + admin secret (same host): scripts run locally with a
# per-run gateway token; PYTHON_BIN must then have slashdhan installed
# (`uv pip install -e ../slash-dhan-mcp` into the workbench venv).
# SLASH_DHAN_MCP_URL=https://dhan-mcp-test1.slash.markets
# SLASH_DHAN_MCP_ADMIN_SECRET=
# SLASHDHAN_CACHE_DIR=/var/lib/slashpy/slashdhan-cache
