# Rendered by setup-uat.sh with the hostname and port from deploy/deploy.env; the rendered file is
# never committed. Installed as the HTTP site first; certbot then adds the TLS block and redirect.
# No authentication (operator decision 2026-11-12): /api/run executes arbitrary Python for anyone
# who can reach the host. Rely on the systemd confinement and the runner limits.
server {
    listen 80;
    server_name __HOSTNAME__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 1m;
    }
}
