# Rendered by setup-uat.sh with the hostname and port from deploy/deploy.env; the rendered file is
# never committed. Installed as the HTTP site first; certbot then adds the TLS block and redirect.
# The whole site sits behind HTTP basic auth because /api/run executes arbitrary Python.
server {
    listen 80;
    server_name __HOSTNAME__;

    auth_basic "/markets sandbox";
    auth_basic_user_file /etc/nginx/htpasswd-__SITE__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 1m;
    }
}
